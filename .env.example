# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# PayPal SANDBOX credentials from https://developer.paypal.com (Apps & Credentials -> Sandbox).
# Leave empty to run in MOCK mode (no network calls to PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Optional AI provider. Leave LLM_PROVIDER empty to use the built-in rule-based parser.
#   gemini            -> needs GEMINI_API_KEY (Google AI Studio free key)
#   openai-compatible -> needs LLM_BASE_URL, LLM_API_KEY, LLM_MODEL
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

PORT=3000
